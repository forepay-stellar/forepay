# Forepay front end. Copy to .env.local and fill in.
# Names only, no values (working agreement #6). Every variable here is public:
# NEXT_PUBLIC_* is inlined into the browser bundle, so never put a secret in one.

# Stellar network. Testnet only.
NEXT_PUBLIC_STELLAR_NETWORK=
NEXT_PUBLIC_STELLAR_RPC_URL=

# Contract and asset addresses. Must match docs/deployments.md exactly.
NEXT_PUBLIC_ADVANCE_CONTRACT_ID=
NEXT_PUBLIC_USDC_CONTRACT_ID=
# CODE:ISSUER, the classic asset behind the SAC. The USDC trustline check (#19) is keyed by it.
NEXT_PUBLIC_USDC_ASSET=

# The backend API from #16. Its /config must report the same addresses as above.
NEXT_PUBLIC_API_URL=

# The proof relay from #17 (the same server as the API; see docs/api.md). While empty, proving revenue runs
# on a mock (src/lib/reclaim/mock.ts) whose proofs the real contract refuses. Only the e2e RPC stub accepts them.
NEXT_PUBLIC_RELAY_URL=
# Google OAuth client id (type "Web application") for the AdSense sign-in popup. Its authorized JavaScript
# origins must list this front end's origins. Public by design; the client secret is never used here.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# WalletConnect, for mobile wallets. From the Reown dashboard.
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=

# Set to 1 only for Playwright runs: swaps the real wallet for a test wallet, and shortens the
# Reclaim mock's delays and the wait between polls of a relay job.
NEXT_PUBLIC_E2E=

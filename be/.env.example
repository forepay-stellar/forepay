# Forepay backend. Copy to be/.env, fill in, then: chmod 600 be/.env
# Never commit .env, never paste its values into an issue, PR or chat.

# Reclaim Developer Portal (https://dev.reclaimprotocol.org): an application's id and secret.
RECLAIM_APP_ID=
RECLAIM_APP_SECRET=

# Google OAuth access token with ONLY the scope
#   https://www.googleapis.com/auth/adsense.readonly
# for the Google account that owns the AdSense account. Expires after about an hour.
# Quickest way: OAuth 2.0 Playground (https://developers.google.com/oauthplayground),
# step 1 pick "AdSense Management API v2" → adsense.readonly, authorize, exchange for tokens.
GOOGLE_ACCESS_TOKEN=

# The borrower's Stellar testnet account (G…). Public; bound into the signed claim.
STELLAR_ADDRESS=

# Testnet secret key (S…) that pays for `verify:proof --submit` (#5). Testnet only;
# funded from friendbot automatically if the account does not exist yet.
STELLAR_SECRET_KEY=

# Optional. If empty, the script uses the only AdSense account the token can read.
ADSENSE_PUBLISHER_ID=

# Optional. Complete calendar months to prove. Default 3.
TRAILING_MONTHS=
